# PostgreSQL connection string used by Prisma (tuition-api)
DATABASE_URL=postgresql://tuition:tuition@localhost:5432/tuition?schema=public
# Secret used to sign JWT access tokens (change in any real deployment)
JWT_SECRET=change-me
# Lifetime of issued JWT access tokens
JWT_EXPIRES_IN=1h
# Port the tuition-api listens on
API_PORT=3000
# Port the MCP server listens on (Streamable HTTP)
MCP_PORT=3001
# Shared API key the agent must send to the MCP server
MCP_API_KEY=change-me-mcp-key
# URL of the MCP server endpoint used by the agent
MCP_URL=http://localhost:3001/mcp
# Base URL of the Kong gateway used by the agent to reach the API
GATEWAY_URL=http://localhost:8000
# Google Gemini API key used by the agent
GEMINI_API_KEY=your-gemini-api-key
# Gemini model name used by the agent
GEMINI_MODEL=gemini-3.8-flash
# Gemini model used when the main model is busy (free tier "high demand" errors)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

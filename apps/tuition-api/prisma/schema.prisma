// Data model for the Tuition API.
// The ER diagram is in docs/ER.md. Business rules are in README §12.
// CHECK constraints that Prisma cannot express are added by hand in the migration SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Access role carried in the JWT.
enum Role {
  STUDENT
  BANK
  ADMIN
}

/// Student master data. Not created by tuition operations.
model Student {
  id        String   @id @default(uuid()) @db.Uuid
  /// 8-digit student number, e.g. "20230001".
  studentNo String   @unique @map("student_no") @db.VarChar(8)
  fullName  String   @map("full_name") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User?
  tuitions Tuition[]

  @@map("students")
}

/// Login account. A STUDENT user is linked to exactly one student; BANK and ADMIN users are not.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(64)
  /// scrypt hash in the form "scrypt$<salt-hex>$<hash-hex>".
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role
  studentId    String?  @unique @map("student_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  student  Student?  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@map("users")
}

/// Assessed tuition of one student for one term. The balance is not stored:
/// balance = amount - sum(payments.amount).
model Tuition {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  /// YYYY-FALL, YYYY-SPRING or YYYY-SUMMER.
  term      String   @db.VarChar(16)
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("USD") @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([studentId, term])
  @@index([term])
  @@map("tuitions")
}

/// A simulated payment against one tuition record. transactionId is the client's idempotency key.
model Payment {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @unique @map("transaction_id") @db.VarChar(64)
  tuitionId     String   @map("tuition_id") @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  /// User whose token submitted the payment (STUDENT or BANK). Kept for auditing.
  paidByUserId  String?  @map("paid_by_user_id") @db.Uuid
  paidAt        DateTime @default(now()) @map("paid_at") @db.Timestamptz(3)

  tuition Tuition @relation(fields: [tuitionId], references: [id], onDelete: Restrict)
  paidBy  User?   @relation(fields: [paidByUserId], references: [id], onDelete: SetNull)

  @@index([tuitionId])
  @@map("payments")
}

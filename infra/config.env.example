# Azure deployment settings. Copy to infra/config.env (not committed) and adjust if needed:
#   cp infra/config.env.example infra/config.env
#
# Azure for Students subscriptions may only allow a few regions. If deploy.sh fails with
# "RequestDisallowedByPolicy" or a region/SKU restriction, choose another region here and run it again.
# The allowed regions can be listed with:
#   az policy assignment list --query "[].parameters.listOfAllowedLocations.value" -o tsv

# Resource group that holds everything (destroy.sh deletes this group).
RESOURCE_GROUP=se4458-tuition-rg

# Azure region. This Azure for Students subscription allows: swedencentral, francecentral, switzerlandnorth, polandcentral, norwayeast.
LOCATION=swedencentral

# Prefix for resource names. A random suffix is added to globally unique names (registry, database server).
NAME_PREFIX=tuition

# PostgreSQL administrator user name (the password is generated).
PG_ADMIN_USER=tuitionadmin

# How container images are built: local (Docker on this machine, the default; needed on Azure for Students,
# which blocks ACR Tasks) or acr (az acr build in Azure).
IMAGE_BUILD=local

# The web chat app reads GEMINI_API_KEY (and GEMINI_MODEL) from the repository's .env; it is stored in Azure
# as a Container Apps secret. Without a key the web chat is skipped.
